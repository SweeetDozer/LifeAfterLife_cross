import { ScrollView } from "std-widgets.slint";
import { Strings } from "../i18n/strings.slint";

export component InspectorPanel inherits Rectangle {
    in property <int> selected_tree_id: -1;
    in property <string> selected_tree_name: "";
    in property <int> selected_person_id: -1;
    in property <int> selected_relationship_id: -1;
    in property <string> selected_relationship_type: "";
    in property <string> selected_relationship_from_first_name: "";
    in property <string> selected_relationship_from_middle_name: "";
    in property <string> selected_relationship_from_last_name: "";
    in property <string> selected_relationship_to_first_name: "";
    in property <string> selected_relationship_to_middle_name: "";
    in property <string> selected_relationship_to_last_name: "";
    in property <string> selected_person_first_name: "";
    in property <string> selected_person_middle_name: "";
    in property <string> selected_person_last_name: "";
    in property <string> selected_person_birth_date: "";
    in property <string> selected_person_death_date: "";
    in property <string> selected_person_description: "";
    in property <bool> inspector_edit_mode: false;
    in property <bool> is_edit_mode: false;
    in property <string> inspector_draft_first_name: "";
    in property <string> inspector_draft_middle_name: "";
    in property <string> inspector_draft_last_name: "";
    in property <string> inspector_draft_birth_date: "";
    in property <string> inspector_draft_death_date: "";
    in property <string> inspector_draft_description: "";

    callback inspector_edit_started();
    callback inspector_edit_canceled();
    callback inspector_edit_saved();
    callback delete_person_requested();
    callback delete_relationship_requested();
    callback inspector_draft_first_name_edited(string);
    callback inspector_draft_middle_name_edited(string);
    callback inspector_draft_last_name_edited(string);
    callback inspector_draft_birth_date_edited(string);
    callback inspector_draft_death_date_edited(string);
    callback inspector_draft_description_edited(string);
    private property <bool> confirm_person_delete: false;
    private property <bool> has_unsaved_changes:
        root.inspector_edit_mode
        && (
            root.inspector_draft_first_name != root.selected_person_first_name
            || root.inspector_draft_middle_name != root.selected_person_middle_name
            || root.inspector_draft_last_name != root.selected_person_last_name
            || root.inspector_draft_birth_date != root.selected_person_birth_date
            || root.inspector_draft_death_date != root.selected_person_death_date
            || root.inspector_draft_description != root.selected_person_description
        );
    private property <string> selected_person_display_name:
        root.selected_person_first_name == "" && root.selected_person_middle_name == "" && root.selected_person_last_name == ""
            ? Strings.select_person_prompt
            : root.selected_person_first_name
                + (root.selected_person_middle_name != ""
                    ? ((root.selected_person_first_name != "" ? " " : "") + root.selected_person_middle_name)
                    : "")
                + (root.selected_person_last_name != ""
                    ? (((root.selected_person_first_name != "" || root.selected_person_middle_name != "") ? " " : "") + root.selected_person_last_name)
                    : "");
    private property <string> selected_person_dates_display:
        root.selected_person_birth_date != "" && root.selected_person_death_date != ""
            ? root.selected_person_birth_date + Strings.date_range_separator + root.selected_person_death_date
        : root.selected_person_birth_date != ""
            ? root.selected_person_birth_date
        : root.selected_person_death_date != ""
            ? root.selected_person_death_date
        : "";
    private property <string> selected_relationship_from_display_name:
        root.selected_relationship_from_first_name
            + (root.selected_relationship_from_middle_name != ""
                ? ((root.selected_relationship_from_first_name != "" ? " " : "") + root.selected_relationship_from_middle_name)
                : "")
            + (root.selected_relationship_from_last_name != ""
                ? (((root.selected_relationship_from_first_name != "" || root.selected_relationship_from_middle_name != "") ? " " : "") + root.selected_relationship_from_last_name)
                : "");
    private property <string> selected_relationship_to_display_name:
        root.selected_relationship_to_first_name
            + (root.selected_relationship_to_middle_name != ""
                ? ((root.selected_relationship_to_first_name != "" ? " " : "") + root.selected_relationship_to_middle_name)
                : "")
            + (root.selected_relationship_to_last_name != ""
                ? (((root.selected_relationship_to_first_name != "" || root.selected_relationship_to_middle_name != "") ? " " : "") + root.selected_relationship_to_last_name)
                : "");
    private property <string> selected_relationship_type_label:
        root.selected_relationship_type == Strings.relationship_type_values[0] ? Strings.relationship_type_labels[0]
        : root.selected_relationship_type == Strings.relationship_type_values[1] ? Strings.relationship_type_labels[1]
        : root.selected_relationship_type == Strings.relationship_type_values[2] ? Strings.relationship_type_labels[2]
        : root.selected_relationship_type == Strings.relationship_type_values[3] ? Strings.relationship_type_labels[3]
        : root.selected_relationship_type;
    private property <string> selected_relationship_summary:
        root.selected_relationship_from_display_name == "" && root.selected_relationship_to_display_name == ""
            ? ""
            : root.selected_relationship_from_display_name
                + " " + Strings.relationship_summary_separator + " "
                + root.selected_relationship_type_label
                + " " + Strings.relationship_summary_separator + " "
                + root.selected_relationship_to_display_name;

    background: #f9f4ee;
    border-radius: 18px;
    border-color: #e9decf;
    border-width: 1px;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        Text {
            text: Strings.details_title;
            font-size: 22px;
            font-weight: 600;
            color: #5b4738;
        }

        Rectangle {
            vertical-stretch: 1;
            background: #fffaf5;
            border-radius: 14px;
            border-color: #ede1d3;
            border-width: 1px;

            ScrollView {
                width: parent.width;
                height: parent.height;

                Rectangle {
                    width: parent.width;
                    height: content.preferred-height + 40px;
                    background: transparent;

                    content := VerticalLayout {
                        width: parent.width;
                        padding: 20px;
                        spacing: 14px;

                        Text {
                            width: parent.width;
                            text: root.selected_relationship_id >= 0
                                ? Strings.relationship_title
                                : root.selected_person_id >= 0
                                    ? root.selected_person_display_name
                                    : Strings.select_person_prompt;
                            font-size: 18px;
                            color: #6b5645;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }

                        if (root.has_unsaved_changes) : Rectangle {
                            height: unsaved_changes_text.preferred-height + 20px;
                            background: #f6ead9;
                            border-radius: 12px;
                            border-color: #e0c9ab;
                            border-width: 1px;

                            unsaved_changes_text := Text {
                                x: 14px;
                                y: 10px;
                                width: parent.width - 28px;
                                text: Strings.unsaved_changes;
                                color: #8a6b4f;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }

                        if (root.selected_relationship_id >= 0) : VerticalLayout {
                            spacing: 12px;

                            Rectangle {
                                background: #f7efe6;
                                border-radius: 12px;
                                border-color: #e2d4c3;
                                border-width: 1px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;

                                    Text {
                                        text: Strings.relationship_title;
                                        color: #6b5645;
                                    }

                                    Text {
                                        text: root.selected_relationship_summary;
                                        color: #4f3b2e;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Rectangle {
                                background: #f7efe6;
                                border-radius: 12px;
                                border-color: #e2d4c3;
                                border-width: 1px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;

                                    Text {
                                        text: Strings.relationship_type_title;
                                        color: #6b5645;
                                    }

                                    Text {
                                        text: root.selected_relationship_type_label;
                                        color: #4f3b2e;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            Rectangle {
                                background: #f8f1e8;
                                border-radius: 12px;
                                border-color: #e2d4c3;
                                border-width: 1px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;

                                    Text {
                                        text: Strings.details_title;
                                        color: #6b5645;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: Strings.relationship_edit_unavailable;
                                        color: #95806f;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if (root.is_edit_mode) : TouchArea {
                                height: 38px;

                                Rectangle {
                                    width: parent.width;
                                    height: parent.height;
                                    background: #f1e0d2;
                                    border-radius: 12px;
                                    border-color: #c79f77;
                                    border-width: 1px;

                                    Text {
                                        text: Strings.delete_relationship_action;
                                        color: #6b5645;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                clicked => {
                                    root.delete_relationship_requested();
                                }
                            }
                        }

                        if (root.selected_relationship_id < 0 && root.selected_person_id >= 0) : VerticalLayout {
                            spacing: 12px;

                            if (!root.inspector_edit_mode || !root.is_edit_mode) : VerticalLayout {
                                spacing: 12px;

                                Rectangle {
                                    background: #f7efe6;
                                    border-radius: 12px;
                                    border-color: #e2d4c3;
                                    border-width: 1px;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;

                                        Text {
                                            text: Strings.first_name_label;
                                            color: #6b5645;
                                        }

                                        Text {
                                            text: root.selected_person_first_name == "" ? Strings.not_set_label : root.selected_person_first_name;
                                            color: #4f3b2e;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #f7efe6;
                                    border-radius: 12px;
                                    border-color: #e2d4c3;
                                    border-width: 1px;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;

                                        Text {
                                            text: Strings.middle_name_label;
                                            color: #6b5645;
                                        }

                                        Text {
                                            text: root.selected_person_middle_name == "" ? Strings.not_set_label : root.selected_person_middle_name;
                                            color: #4f3b2e;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #f7efe6;
                                    border-radius: 12px;
                                    border-color: #e2d4c3;
                                    border-width: 1px;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;

                                        Text {
                                            text: Strings.last_name_label;
                                            color: #6b5645;
                                        }

                                        Text {
                                            text: root.selected_person_last_name == "" ? Strings.not_set_label : root.selected_person_last_name;
                                            color: #4f3b2e;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                Rectangle {
                                    background: #f7efe6;
                                    border-radius: 12px;
                                    border-color: #e2d4c3;
                                    border-width: 1px;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;

                                        Text {
                                            text: Strings.dates_label;
                                            color: #6b5645;
                                        }

                                        Text {
                                            text: root.selected_person_dates_display == "" ? Strings.no_dates_available : root.selected_person_dates_display;
                                            color: #4f3b2e;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                if (root.is_edit_mode) : TouchArea {
                                    height: 38px;

                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        background: #f7efe6;
                                        border-radius: 12px;
                                        border-color: #decfbd;
                                        border-width: 1px;

                                        Text {
                                            text: Strings.edit_action;
                                            color: #6b5645;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    clicked => {
                                        root.confirm_person_delete = false;
                                        root.inspector_edit_started();
                                    }
                                }
                            }

                            if (root.inspector_edit_mode && root.is_edit_mode) : VerticalLayout {
                                spacing: 12px;

                                Text {
                                    width: parent.width;
                                    text: Strings.editing_person_label;
                                    color: #95806f;
                                    wrap: word-wrap;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: Strings.first_name_label;
                                    color: #6b5645;
                                }

                                Rectangle {
                                    height: 48px;
                                    background: #fffdf9;
                                    border-radius: 12px;
                                    border-color: name_input.has-focus ? #c79f77 : #d8c7b5;
                                    border-width: 1px;
                                    clip: true;

                                    name_input := TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        text: root.inspector_draft_first_name;
                                        color: #4f3b2e;
                                        selection-background-color: #ead8c5;
                                        selection-foreground-color: #4f3b2e;
                                        single-line: true;
                                        vertical-alignment: center;
                                        edited => {
                                            root.inspector_draft_first_name_edited(self.text);
                                        }
                                    }

                                    if (root.inspector_draft_first_name == "" && !name_input.has-focus) : Text {
                                        x: 12px;
                                        y: 0px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: Strings.first_name_label;
                                        color: #b69f8b;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: Strings.middle_name_label;
                                    color: #6b5645;
                                }

                                Rectangle {
                                    height: 48px;
                                    background: #fffdf9;
                                    border-radius: 12px;
                                    border-color: middle_input.has-focus ? #c79f77 : #d8c7b5;
                                    border-width: 1px;
                                    clip: true;

                                    middle_input := TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        text: root.inspector_draft_middle_name;
                                        color: #4f3b2e;
                                        selection-background-color: #ead8c5;
                                        selection-foreground-color: #4f3b2e;
                                        single-line: true;
                                        vertical-alignment: center;
                                        edited => {
                                            root.inspector_draft_middle_name_edited(self.text);
                                        }
                                    }

                                    if (root.inspector_draft_middle_name == "" && !middle_input.has-focus) : Text {
                                        x: 12px;
                                        y: 0px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: Strings.optional_label;
                                        color: #b69f8b;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: Strings.last_name_label;
                                    color: #6b5645;
                                }

                                Rectangle {
                                    height: 48px;
                                    background: #fffdf9;
                                    border-radius: 12px;
                                    border-color: last_input.has-focus ? #c79f77 : #d8c7b5;
                                    border-width: 1px;
                                    clip: true;

                                    last_input := TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        text: root.inspector_draft_last_name;
                                        color: #4f3b2e;
                                        selection-background-color: #ead8c5;
                                        selection-foreground-color: #4f3b2e;
                                        single-line: true;
                                        vertical-alignment: center;
                                        edited => {
                                            root.inspector_draft_last_name_edited(self.text);
                                        }
                                    }

                                    if (root.inspector_draft_last_name == "" && !last_input.has-focus) : Text {
                                        x: 12px;
                                        y: 0px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: Strings.optional_label;
                                        color: #b69f8b;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: Strings.birth_date_label;
                                    color: #6b5645;
                                }

                                Rectangle {
                                    height: 48px;
                                    background: #fffdf9;
                                    border-radius: 12px;
                                    border-color: birth_input.has-focus ? #c79f77 : #d8c7b5;
                                    border-width: 1px;
                                    clip: true;

                                    birth_input := TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        text: root.inspector_draft_birth_date;
                                        color: #4f3b2e;
                                        selection-background-color: #ead8c5;
                                        selection-foreground-color: #4f3b2e;
                                        single-line: true;
                                        vertical-alignment: center;
                                        edited => {
                                            root.inspector_draft_birth_date_edited(self.text);
                                        }
                                    }

                                    if (root.inspector_draft_birth_date == "" && !birth_input.has-focus) : Text {
                                        x: 12px;
                                        y: 0px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: Strings.optional_label;
                                        color: #b69f8b;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: Strings.death_date_label;
                                    color: #6b5645;
                                }

                                Rectangle {
                                    height: 48px;
                                    background: #fffdf9;
                                    border-radius: 12px;
                                    border-color: death_input.has-focus ? #c79f77 : #d8c7b5;
                                    border-width: 1px;
                                    clip: true;

                                    death_input := TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        text: root.inspector_draft_death_date;
                                        color: #4f3b2e;
                                        selection-background-color: #ead8c5;
                                        selection-foreground-color: #4f3b2e;
                                        single-line: true;
                                        vertical-alignment: center;
                                        edited => {
                                            root.inspector_draft_death_date_edited(self.text);
                                        }
                                    }

                                    if (root.inspector_draft_death_date == "" && !death_input.has-focus) : Text {
                                        x: 12px;
                                        y: 0px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: Strings.optional_label;
                                        color: #b69f8b;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    TouchArea {
                                        height: 38px;

                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height;
                                            background: #ead8c5;
                                            border-radius: 12px;
                                            border-color: #c79f77;
                                            border-width: 1px;

                                            Text {
                                                text: Strings.save_action;
                                                color: #4f3b2e;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        clicked => {
                                            root.confirm_person_delete = false;
                                            root.inspector_edit_saved();
                                        }
                                    }

                                    TouchArea {
                                        height: 38px;

                                        Rectangle {
                                            width: parent.width;
                                            height: parent.height;
                                            background: #f7efe6;
                                            border-radius: 12px;
                                            border-color: #decfbd;
                                            border-width: 1px;

                                            Text {
                                                text: Strings.cancel_action;
                                                color: #6b5645;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }

                                        clicked => {
                                            root.confirm_person_delete = false;
                                            root.inspector_edit_canceled();
                                        }
                                    }
                                }

                                if (!root.confirm_person_delete) : TouchArea {
                                    height: 38px;

                                    Rectangle {
                                        width: parent.width;
                                        height: parent.height;
                                        background: #f1e0d2;
                                        border-radius: 12px;
                                        border-color: #c79f77;
                                        border-width: 1px;

                                        Text {
                                            text: Strings.delete_person_action;
                                            color: #6b5645;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    clicked => {
                                        root.confirm_person_delete = true;
                                    }
                                }

                                if (root.confirm_person_delete) : Rectangle {
                                    background: #f8f1e8;
                                    border-radius: 12px;
                                    border-color: #e2d4c3;
                                    border-width: 1px;

                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;

                                        Text {
                                            text: Strings.confirm_delete_person_title;
                                            color: #6b5645;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                        }

                                        Text {
                                            text: Strings.confirm_delete_person_body;
                                            color: #95806f;
                                            wrap: word-wrap;
                                        }

                                        HorizontalLayout {
                                            spacing: 10px;

                                            TouchArea {
                                                height: 38px;

                                                Rectangle {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    background: #ead8c5;
                                                    border-radius: 12px;
                                                    border-color: #c79f77;
                                                    border-width: 1px;

                                                    Text {
                                                        text: Strings.confirm_delete_action;
                                                        color: #4f3b2e;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                clicked => {
                                                    root.confirm_person_delete = false;
                                                    root.delete_person_requested();
                                                }
                                            }

                                            TouchArea {
                                                height: 38px;

                                                Rectangle {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    background: #f7efe6;
                                                    border-radius: 12px;
                                                    border-color: #decfbd;
                                                    border-width: 1px;

                                                    Text {
                                                        text: Strings.cancel_action;
                                                        color: #6b5645;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                clicked => {
                                                    root.confirm_person_delete = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if (!root.inspector_edit_mode || !root.is_edit_mode) : Rectangle {
                                background: #f8f1e8;
                                border-radius: 12px;
                                border-color: #e2d4c3;
                                border-width: 1px;

                                VerticalLayout {
                                    padding: 14px;
                                    spacing: 6px;

                                    Text {
                                        text: Strings.details_title;
                                        color: #6b5645;
                                        font-weight: 600;
                                    }

                                    Text {
                                        text: root.selected_person_description == "" ? Strings.no_extended_details : root.selected_person_description;
                                        color: #4f3b2e;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            if (root.inspector_edit_mode && root.is_edit_mode) : VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: Strings.details_title;
                                    color: #6b5645;
                                }

                                Rectangle {
                                    height: 120px;
                                    background: #fffdf9;
                                    border-radius: 12px;
                                    border-color: description_input.has-focus ? #c79f77 : #d8c7b5;
                                    border-width: 1px;
                                    clip: true;

                                    description_input := TextInput {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height - 20px;
                                        text: root.inspector_draft_description;
                                        color: #4f3b2e;
                                        selection-background-color: #ead8c5;
                                        selection-foreground-color: #4f3b2e;
                                        vertical-alignment: top;
                                        wrap: word-wrap;
                                        edited => {
                                            root.inspector_draft_description_edited(self.text);
                                        }
                                    }

                                    if (root.inspector_draft_description == "" && !description_input.has-focus) : Text {
                                        x: 12px;
                                        y: 10px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: Strings.optional_label;
                                        color: #b69f8b;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }

                        if (root.selected_relationship_id < 0 && root.selected_person_id < 0) : Rectangle {
                            height: empty_state_text.preferred-height + 28px;
                            background: #f7efe6;
                            border-radius: 12px;
                            border-color: #e2d4c3;
                            border-width: 1px;

                            empty_state_text := Text {
                                x: 14px;
                                y: 14px;
                                width: parent.width - 28px;
                                text: Strings.select_person_details_prompt;
                                color: #95806f;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

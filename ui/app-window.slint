import { LoginPage } from "./pages/login-page.slint";
import { RegisterPage } from "./pages/register-page.slint";
import { MainLayout } from "./layouts/main-layout.slint";
import { PersonNode, RelationshipLine } from "./components/graph-canvas.slint";
import { Strings } from "./i18n/strings.slint";

export component AppWindow inherits Window {
    preferred-width: 680px;
    preferred-height: 820px;
    min-width: 560px;
    min-height: 640px;
    title: Strings.app_name;

    in-out property <int> current_page: 0;

    in-out property <string> login_email_text: "";
    in-out property <string> login_password_text: "";
    in-out property <int> login_status_code: 0;
    in-out property <string> login_status_message: "";

    in-out property <string> register_email_text: "";
    in-out property <string> register_password_text: "";
    in-out property <int> register_status_code: 0;
    in-out property <string> register_status_message: "";
    in-out property <[string]> tree_names: [];
    in-out property <[int]> tree_ids: [];
    in-out property <int> selected_tree_id: -1;
    in-out property <string> selected_tree_name: "";
    in-out property <string> tree_rename_name: "";
    in-out property <[PersonNode]> persons: [];
    in-out property <[RelationshipLine]> relationship_lines: [];
    in-out property <int> selected_person_id: -1;
    in-out property <int> selected_relationship_id: -1;
    in-out property <string> selected_relationship_type: "";
    in-out property <string> selected_relationship_from_first_name: "";
    in-out property <string> selected_relationship_from_middle_name: "";
    in-out property <string> selected_relationship_from_last_name: "";
    in-out property <string> selected_relationship_to_first_name: "";
    in-out property <string> selected_relationship_to_middle_name: "";
    in-out property <string> selected_relationship_to_last_name: "";
    in-out property <string> selected_person_first_name: "";
    in-out property <string> selected_person_middle_name: "";
    in-out property <string> selected_person_last_name: "";
    in-out property <string> selected_person_birth_date: "";
    in-out property <string> selected_person_death_date: "";
    in-out property <string> selected_person_description: "";
    in-out property <bool> inspector_edit_mode: false;
    in-out property <string> inspector_draft_first_name: "";
    in-out property <string> inspector_draft_middle_name: "";
    in-out property <string> inspector_draft_last_name: "";
    in-out property <string> inspector_draft_birth_date: "";
    in-out property <string> inspector_draft_death_date: "";
    in-out property <string> inspector_draft_description: "";
    in-out property <bool> is_edit_mode: false;
    in-out property <bool> relationship_creation_active: false;
    in-out property <bool> relationship_type_selection_visible: false;
    in-out property <int> relationship_creation_step: 0;
    in-out property <string> relationship_error_message: "";
    in-out property <float> canvas_offset_x: 0;
    in-out property <float> canvas_offset_y: 0;
    in-out property <float> canvas_zoom: 1.0;

    callback login_clicked(string, string);
    callback register_clicked(string, string);
    callback tree_selected(int);
    callback add_tree_requested();
    callback tree_rename_name_edited(string);
    callback rename_tree_requested();
    callback delete_tree_requested();
    callback person_selected(int);
    callback relationship_selected(int);
    callback relationship_hit_test_requested(float, float);
    callback person_move_started(int);
    callback person_moved(int, float, float);
    callback person_move_finished(int, float, float);
    callback add_person_requested();
    callback relationship_creation_started();
    callback relationship_creation_canceled();
    callback relationship_type_selected(string);
    callback auto_layout_requested();
    callback inspector_edit_started();
    callback inspector_edit_canceled();
    callback inspector_edit_saved();
    callback delete_person_requested();
    callback delete_relationship_requested();
    callback inspector_draft_first_name_edited(string);
    callback inspector_draft_middle_name_edited(string);
    callback inspector_draft_last_name_edited(string);
    callback inspector_draft_birth_date_edited(string);
    callback inspector_draft_death_date_edited(string);
    callback inspector_draft_description_edited(string);
    callback toggle_edit_mode();
    callback canvas_selection_cleared();
    callback canvas_panned(float, float);
    callback canvas_zoom_changed(float);

    callback logout_requested();

    if (current_page == 0) : LoginPage {
        width: parent.width;
        height: parent.height;

        email_text <=> root.login_email_text;
        password_text <=> root.login_password_text;
        status_code <=> root.login_status_code;
        status_message <=> root.login_status_message;

        login_clicked(email, password) => {
            root.login_clicked(email, password);
        }

        open_register => {
            root.current_page = 1;
        }
    }

    if (current_page == 1) : RegisterPage {
        width: parent.width;
        height: parent.height;

        email_text <=> root.register_email_text;
        password_text <=> root.register_password_text;
        status_code <=> root.register_status_code;
        status_message <=> root.register_status_message;

        register_clicked(email, password) => {
            root.register_clicked(email, password);
        }

        open_login => {
            root.current_page = 0;
        }
    }

    if (current_page == 2) : MainLayout {
        width: parent.width;
        height: parent.height;

        tree_names: root.tree_names;
        tree_ids: root.tree_ids;
        selected_tree_id: root.selected_tree_id;
        selected_tree_name: root.selected_tree_name;
        persons: root.persons;
        relationship_lines: root.relationship_lines;
        selected_person_id: root.selected_person_id;
        selected_relationship_id: root.selected_relationship_id;
        selected_relationship_type: root.selected_relationship_type;
        selected_relationship_from_first_name: root.selected_relationship_from_first_name;
        selected_relationship_from_middle_name: root.selected_relationship_from_middle_name;
        selected_relationship_from_last_name: root.selected_relationship_from_last_name;
        selected_relationship_to_first_name: root.selected_relationship_to_first_name;
        selected_relationship_to_middle_name: root.selected_relationship_to_middle_name;
        selected_relationship_to_last_name: root.selected_relationship_to_last_name;
        selected_person_first_name: root.selected_person_first_name;
        selected_person_middle_name: root.selected_person_middle_name;
        selected_person_last_name: root.selected_person_last_name;
        selected_person_birth_date: root.selected_person_birth_date;
        selected_person_death_date: root.selected_person_death_date;
        selected_person_description: root.selected_person_description;
        inspector_edit_mode: root.inspector_edit_mode;
        is_edit_mode: root.is_edit_mode;
        inspector_draft_first_name: root.inspector_draft_first_name;
        inspector_draft_middle_name: root.inspector_draft_middle_name;
        inspector_draft_last_name: root.inspector_draft_last_name;
        inspector_draft_birth_date: root.inspector_draft_birth_date;
        inspector_draft_death_date: root.inspector_draft_death_date;
        inspector_draft_description: root.inspector_draft_description;
        relationship_creation_active: root.relationship_creation_active;
        relationship_type_selection_visible: root.relationship_type_selection_visible;
        relationship_creation_step: root.relationship_creation_step;
        relationship_error_message: root.relationship_error_message;
        canvas_offset_x: root.canvas_offset_x;
        canvas_offset_y: root.canvas_offset_y;
        canvas_zoom: root.canvas_zoom;

        tree_selected(index) => {
            root.tree_selected(index);
        }

        add_tree_requested => {
            root.add_tree_requested();
        }
        tree_rename_name_edited(value) => {
            root.tree_rename_name_edited(value);
        }
        rename_tree_requested => {
            root.rename_tree_requested();
        }
        delete_tree_requested => {
            root.delete_tree_requested();
        }

        person_selected(person_id) => {
            root.person_selected(person_id);
        }

        relationship_selected(relationship_id) => {
            root.relationship_selected(relationship_id);
        }
        relationship_hit_test_requested(x, y) => {
            root.relationship_hit_test_requested(x, y);
        }
        person_move_started(person_id) => {
            root.person_move_started(person_id);
        }

        person_moved(person_id, x, y) => {
            root.person_moved(person_id, x, y);
        }

        person_move_finished(person_id, x, y) => {
            root.person_move_finished(person_id, x, y);
        }

        add_person_requested => {
            root.add_person_requested();
        }

        relationship_creation_started => {
            root.relationship_creation_started();
        }

        relationship_creation_canceled => {
            root.relationship_creation_canceled();
        }

        relationship_type_selected(value) => {
            root.relationship_type_selected(value);
        }

        auto_layout_requested => {
            root.auto_layout_requested();
        }

        inspector_edit_started => {
            root.inspector_edit_started();
        }

        inspector_edit_canceled => {
            root.inspector_edit_canceled();
        }

        inspector_edit_saved => {
            root.inspector_edit_saved();
        }

        delete_person_requested => {
            root.delete_person_requested();
        }

        delete_relationship_requested => {
            root.delete_relationship_requested();
        }

        inspector_draft_first_name_edited(value) => {
            root.inspector_draft_first_name_edited(value);
        }

        inspector_draft_middle_name_edited(value) => {
            root.inspector_draft_middle_name_edited(value);
        }

        inspector_draft_last_name_edited(value) => {
            root.inspector_draft_last_name_edited(value);
        }

        inspector_draft_birth_date_edited(value) => {
            root.inspector_draft_birth_date_edited(value);
        }

        inspector_draft_death_date_edited(value) => {
            root.inspector_draft_death_date_edited(value);
        }

        inspector_draft_description_edited(value) => {
            root.inspector_draft_description_edited(value);
        }

        toggle_edit_mode => {
            root.toggle_edit_mode();
        }

        canvas_selection_cleared => {
            root.canvas_selection_cleared();
        }

        canvas_panned(offset_x, offset_y) => {
            root.canvas_panned(offset_x, offset_y);
        }

        canvas_zoom_changed(zoom) => {
            root.canvas_zoom_changed(zoom);
        }
        logout_requested => {
            root.logout_requested();
        }
    }
}
